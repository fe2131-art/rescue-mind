<?xml version="1.0"?>
<!-- Static Gazebo-rendered overview camera used ONLY for the demo video (relief-depot missions, k = 4: all four bays, the shelter and the aisles in view; scripts/film_depot.sh).
     Spawned at runtime (scripts/spawn_film_camera.sh); never seen by the VLM. -->
<sdf version="1.9">
  <model name="film_camera_overview">
    <static>true</static>
    <pose>-0.3 -7.5 6.5 0 0.72 1.5708</pose>
    <link name="link">
      <sensor name="film_camera_overview" type="camera">
        <topic>/film_camera_overview</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image><width>960</width><height>540</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>40</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
